{
  "name": "obi-studio-epub",
  "version": "1.0.0-alpha.1",
  "description": "Obi Studio EPUB: maquetador visual de novelas ligeras",
  "scripts": {
    "test": "node --import tsx --test src/pruebas/*.test.ts",
    "tipos": "tsc --noEmit -p . && tsc --noEmit -p app/renderer",
    "dev:web": "tsx app/servidor.ts --dev",
    "cli": "tsx src/cli.ts",
    "build": "node scripts/construir.mjs",
    "app": "node scripts/construir.mjs && electron .",
    "recursos": "node scripts/preparar-recursos.mjs",
    "instaladores": "node scripts/construir.mjs && electron-builder --publish never"
  },
  "author": {
    "name": "MikeMR13"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-collaboration": "^3.34.0",
    "@tiptap/extension-collaboration-caret": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-subscript": "^3.34.0",
    "@tiptap/extension-superscript": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/y-tiptap": "^3.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vivliostyle/viewer": "^2.46.0",
    "@xmldom/xmldom": "^0.9.12",
    "axe-core": "^4.14.1",
    "docx": "^9.16.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "hyphenopoly": "^6.1.0",
    "jimp": "^1.6.1",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "type": "module",
  "private": true,
  "main": "dist/main.mjs",
  "productName": "Obi Studio EPUB",
  "build": {
    "appId": "com.obistudio.epub",
    "productName": "Obi Studio EPUB",
    "directories": {
      "output": "instaladores"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "recursos",
        "to": "recursos",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Obi-Studio-EPUB-${version}-Windows.${ext}",
      "signtoolOptions": {
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "language": "3082",
      "shortcutName": "Obi Studio EPUB"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Obi-Studio-EPUB-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "Obi-Studio-EPUB-${version}-Linux.${ext}",
      "maintainer": "MikeMR13"
    },
    "fileAssociations": [
      {
        "ext": "obi",
        "name": "Proyecto de Obi Studio",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "harfbuzzjs": "^1.6.4"
  }
}
